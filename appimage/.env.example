# Copy this file to .env and adjust values for your system.
#
# HOSTUID / HOSTGID are auto-detected from the workspace owner.
# Uncomment to override (e.g. in CI matrices, or when workspace
# ownership doesn't match the invoking user).
#HOSTUID=
#HOSTGID=

# Version string used in the AppImage filename.
# e.g. netpanzer-editor-0.1-x86_64.AppImage
VERSION=0.1
