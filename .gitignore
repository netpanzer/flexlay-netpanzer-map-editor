# Meson build directory and AppImage output
/build/
/out/

# Meson-generated MOC files (can appear in src/ with in-source builds)
*.moc

# Windows installer staging directory
/_staging/

# Python bytecode cache
__pycache__/
*.pyc

# Inno Setup output (OutputDir points at the repo root)
/netpanzer-editor-*-setup.exe
/netpanzer-editor-*-setup.exe.sha256sum
